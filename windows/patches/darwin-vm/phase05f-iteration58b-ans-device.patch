diff --git a/include/hw/arm/apple_ans.h b/include/hw/arm/apple_ans.h
new file mode 100644
index 0000000..0262d7d
--- /dev/null
+++ b/include/hw/arm/apple_ans.h
@@ -0,0 +1,57 @@
+#ifndef APPLE_ANS_H
+#define APPLE_ANS_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+#include "xnu/apple_dtree.h"
+
+#define TYPE_APPLE_ANS "apple-ans"
+OBJECT_DECLARE_SIMPLE_TYPE(AppleANSState, APPLE_ANS)
+
+/* Number of MMIO BARs declared by the ANS device-tree node. */
+#define ANS_NUM_REGS 14
+
+/*
+ * Minimal ANS (Apple ANS2 / NVMe coprocessor) MMIO model.
+ *
+ * This is Iteration 58B: map the ANS MMIO ranges from the device tree
+ * and log guest accesses so the first hardware primitives the Apple
+ * ASCWrap/ANS driver touches become observable. The only behaviorally
+ * emulated registers are the coprocessor control and boot-status
+ * values that the Linux apple.c driver taught us:
+ *
+ *   COPROC_CPU_CONTROL (offset 0x44) - coprocessor run/halt control
+ *   BOOT_STATUS        (offset 0x1300) - firmware readiness; 0xde71ce55
+ *                       means booted
+ *
+ * Everything else reads as zero and writes are recorded for the next
+ * iteration of the protocol model.
+ */
+struct AppleANSState {
+    SysBusDevice parent_obj;
+
+    /* Passed from darwin.c via apple_ans_create() before realize. */
+    struct dtree_node *create_ans_node;
+    uint64_t create_iobase;
+
+    /* One MMIO subregion per active device-tree reg entry. */
+    MemoryRegion iomem[ANS_NUM_REGS];
+    hwaddr reg_base[ANS_NUM_REGS];
+    uint64_t reg_len[ANS_NUM_REGS];
+    unsigned sysbus_slot[ANS_NUM_REGS];
+    unsigned num_regs;
+
+    /* Behavioral state */
+    uint64_t coproc_cpu_control;   /* offset 0x44 in BAR0 */
+    uint64_t boot_status;          /* offset 0x1300 in BAR0 */
+    uint64_t unhandled_writes[16]; /* LRU log of recent unknown writes */
+    unsigned unhandled_write_head;
+
+    /* Access instrumentation */
+    uint64_t read_count;
+    uint64_t write_count;
+};
+
+DeviceState *apple_ans_create(struct dtree_node *ans_node, uint64_t iobase);
+
+#endif /* APPLE_ANS_H */
