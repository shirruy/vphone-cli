diff --git a/include/xnu/macho.h b/include/xnu/macho.h
index a95ac3a..68bcc59 100644
--- a/include/xnu/macho.h
+++ b/include/xnu/macho.h
@@ -17,6 +17,48 @@ typedef struct segment_command_64 seg_t;
 typedef struct section_64 sect_t;
 typedef struct fileset_entry_command fse_t;
 
+/*
+ * On-disk size of the fixed portion of an LC_FILESET_ENTRY command.
+ * The host sizeof(fse_t) is 32 on LP64 hosts but 40 on LLP64 hosts
+ * (Windows), where union lc_str keeps its char *ptr member. The
+ * on-disk ABI is fixed at 32 bytes, so bounds checks must use this
+ * constant rather than sizeof(fse_t).
+ */
+#define MACHO_FSE_DISK_HEADER_SIZE 32u
+
+/*
+ * Return the NUL-terminated entry_id string of an LC_FILESET_ENTRY
+ * command. entry_id is an lc_str offset relative to the command start,
+ * not a fixed sizeof(fse_t) offset. Returns NULL when the offset is
+ * out of cmdsize or the string is not terminated inside cmdsize.
+ */
+static inline const char *macho_fse_entry_id(const fse_t *f)
+{
+    if (f->cmdsize < MACHO_FSE_DISK_HEADER_SIZE) {
+        return NULL;
+    }
+
+    if (f->entry_id.offset >= f->cmdsize) {
+        return NULL;
+    }
+
+    if (f->entry_id.offset < MACHO_FSE_DISK_HEADER_SIZE) {
+        return NULL;
+    }
+
+    const uint8_t *cmd_start = (const uint8_t *)f;
+    const uint8_t *cmd_end = cmd_start + f->cmdsize;
+    const char *entry_id = (const char *)(cmd_start + f->entry_id.offset);
+
+    for (const uint8_t *p = (const uint8_t *)entry_id; p < cmd_end; p++) {
+        if (*p == '\0') {
+            return entry_id;
+        }
+    }
+
+    return NULL;
+}
