+// Parse the experimental "WxH[@depth]" framebuffer property.
+// Example: "1024x768" or "1024x768@32". Returns false on malformed input.
+static bool parse_fb_geometry(
+    const char *spec,
+    uint32_t *width, uint32_t *height, uint32_t *depth
+) {
+    if (!spec || !*spec) return false;
+    char *end = NULL;
+    unsigned long w = strtoul(spec, &end, 10);
+    if (end == spec || *end != 'x' || w == 0 || w > 4096) return false;
+    spec = end + 1;
+    unsigned long h = strtoul(spec, &end, 10);
+    if (end == spec || h == 0 || h > 4096) return false;
+    *width = (uint32_t)w;
+    *height = (uint32_t)h;
+    *depth = 32;
+    if (*end == '@') {
+        unsigned long d = strtoul(end + 1, &end, 10);
+        if (d == 16 || d == 32) *depth = (uint32_t)d;
+    }
+    return true;
+}
+
+// Hash a guest framebuffer region and update the QEMU console when
+// its contents changed since the last poll.
+static void fb_poll_timer(void *opaque) {
+    DarwinState *s = DARWIN_MACHINE((MachineState *)opaque);
+    if (!s->fb_con || !s->bootinfo.has_fb) return;
+    if (s->fb_update_count == 0) {
+        fprintf(stderr, "darwin-fb: timer tick begin\n");
+    }
+
+    const uint64_t stride =
+        (uint64_t)s->bootinfo.fb_width * (s->bootinfo.fb_depth / 8);
+    const uint64_t total = stride * s->bootinfo.fb_height;
+
+    DisplaySurface *surface =
+        qemu_create_displaysurface_from(
+            (int)s->bootinfo.fb_width,
+            (int)s->bootinfo.fb_height,
+            PIXMAN_x8r8g8b8,
+            (int)stride,
+            NULL  // host buffer copied below from guest RAM
+        );
+    if (!surface) return;
+    if (s->fb_update_count == 0) {
+        fprintf(stderr, "darwin-fb: surface created\n");
+    }
+
+    // Copy guest RAM into the surface data buffer.
+    uint8_t *dst = (uint8_t *)surface_data(surface);
+    uint64_t done = 0;
+    const uint64_t chunk = 1 << 20;
+    while (done < total) {
+        uint64_t n = MIN(chunk, total - done);
+        address_space_read(
+            &address_space_memory,
+            s->bootinfo.fb_base + done,
+            MEMTXATTRS_UNSPECIFIED,
+            dst + done,
+            n
+        );
+        done += n;
+    }
+    if (s->fb_update_count == 0) {
+        fprintf(stderr, "darwin-fb: guest ram copied\n");
+    }
+
+    // Hash change detection.
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (uint64_t i = 0; i < total; i += 64) {
+        uint64_t v = 0;
+        for (uint64_t j = 0; j < 8 && i + j < total; j++) {
+            v = (v << 8) | dst[i + j];
+        }
+        h = (h ^ v) * 0x100000001b3ULL;
+    }
+
+    if (h == s->fb_hash) {
+        qemu_free_displaysurface(surface);
+        timer_mod(s->fb_timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 500);
+        return;
+    }
+    s->fb_hash = h;
+    s->fb_update_count++;
+    if (s->fb_update_count == 1) {
+        fprintf(stderr, "darwin-fb: about to set surface\n");
+    }
+
+    // Experimental activity instrumentation: log the first few
+    // content changes so headless captures can prove the guest
+    // writes changing framebuffer data.
+    if (s->fb_update_count <= 16) {
+        fprintf(stderr,
+            "darwin-fb: update=%u hash=0x%016llX\n",
+            s->fb_update_count,
+            (unsigned long long)h);
+    }
+    // Dump the framebuffer as PPM on the first frame so a real
+    // screenshot artifact exists (no fake pixels).
+    if (s->fb_update_count == 1 || s->fb_update_count == 20) {
+        char ppm_name[64];
+        snprintf(ppm_name, sizeof(ppm_name),
+                 "darwin-fb-frame-%u.ppm", s->fb_update_count);
+        FILE *ppm = fopen(ppm_name, "wb");
+        if (ppm) {
+            fprintf(ppm, "P6\n%u %u\n255\n",
+                    s->bootinfo.fb_width, s->bootinfo.fb_height);
+            uint8_t *d = (uint8_t *)surface_data(surface);
+            uint32_t stride =
+                s->bootinfo.fb_width * (s->bootinfo.fb_depth / 8);
+            for (uint32_t y = 0; y < s->bootinfo.fb_height; y++) {
+                for (uint32_t x = 0; x < s->bootinfo.fb_width; x++) {
+                    // x8r8g8b8 little-endian: B G R X
+                    uint8_t *p = d + y * stride + x * 4;
+                    fputc(p[2], ppm); // R
+                    fputc(p[1], ppm); // G
+                    fputc(p[0], ppm); // B
+                }
+            }
+            fclose(ppm);
+            fprintf(stderr, "darwin-fb: wrote %s\n", ppm_name);
+        }
+    }
+
+    qemu_console_set_surface(s->fb_con, surface);
+    if (s->fb_update_count == 1) {
+        fprintf(stderr, "darwin-fb: surface set\n");
+    }
+    qemu_console_update_full(s->fb_con);
+    if (s->fb_update_count == 1) {
+        fprintf(stderr, "darwin-fb: update_full done\n");
+    }
+    timer_mod(s->fb_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 500);
+}
+
+// The console hw ops must never be NULL: qemu_console_hw_update
+// dereferences hw_ops->gfx_update unconditionally.
+static void fb_gfx_invalidate(void *opaque) { (void)opaque; }
+static const GraphicHwOps fb_hw_ops = {
+    .invalidate = fb_gfx_invalidate,
+    /* gfx_update intentionally NULL: the poll timer drives updates. */
+};
+
+// Create the experimental framebuffer console + poll timer.
+static void darwin_init_fb(MachineState *ms) {
+    DarwinState *s = DARWIN_MACHINE(ms);
+    uint32_t w = 0, h = 0, depth = 0;
+    if (!parse_fb_geometry(s->bootinfo.fb, &w, &h, &depth)) {
+        if (s->bootinfo.fb && *s->bootinfo.fb) {
+            fprintf(stderr,
+                "darwin: invalid -M darwin,fb= spec: %s\n",
+                s->bootinfo.fb);
+            exit(1);
+        }
+        return; // framebuffer disabled (default: headless behavior)
+    }
+
+    const uint64_t rowbytes = (uint64_t)w * (depth / 8);
+    const uint64_t size = rowbytes * h;
+    // Place the framebuffer at the top of DRAM, page aligned.
+    const uint64_t base =
+        ROUND_DOWN_POW2(
+            s->bootinfo.dram_base + s->bootinfo.dram_size - size,
+            DARWIN_PAGE_SIZE
+        );
+    if (base < s->bootinfo.dram_base + s->bootinfo.dram_size / 2) {
+        fprintf(stderr, "darwin: framebuffer too large for DRAM\n");
+        exit(1);
+    }
+
+    s->bootinfo.has_fb = true;
+    s->bootinfo.fb_base = base;
+    s->bootinfo.fb_size = size;
+    s->bootinfo.fb_width = w;
+    s->bootinfo.fb_height = h;
+    s->bootinfo.fb_rowbytes = (uint32_t)rowbytes;
+    s->bootinfo.fb_depth = depth;
+
+    s->fb_con = qemu_graphic_console_create(NULL, 0, &fb_hw_ops, s);
+    if (!s->fb_con) {
+        fprintf(stderr, "darwin: graphic console creation failed\n");
+        exit(1);
+    }
+    s->fb_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, fb_poll_timer, s);
+    timer_mod(s->fb_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1000);
+
+    fprintf(stderr,
+        "darwin: experimental framebuffer %ux%u depth=%u "
+        "at 0x%016llX size=0x%llX\n",
+        w, h, depth,
+        (unsigned long long)base,
+        (unsigned long long)size);
+}
