    "Replace BSD strsep path tokenization with GLib g_strsplit",
    "Use BIT_ULL for 36-bit and 63-bit masks on Windows LLP64"
  ],
  "build_configuration": {
    "target": "aarch64-softmmu",
    "plugins": "disabled",
    "rust": "disabled",
    "docs": "disabled"
