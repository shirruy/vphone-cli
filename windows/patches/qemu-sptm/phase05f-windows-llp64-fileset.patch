--- test-xnu-llp64.c ---

/*
 * XNU boot LLP64 ABI regression tests.
 *
 * Windows x64 is LLP64: unsigned long is 32 bits wide.  The XNU boot
 * headers must never derive address masks or page constants from
 * host-width BIT() definitions, otherwise every guest physical
 * address at or above 4 GiB is truncated to its low 32 bits.  The
 * Phase 5F SPTM Data Abort was caused by exactly this defect in
 * ROUND_NEXT_PAGE via ONE_KB/ONE_MB/ONE_GB.
 *
 * This work is licensed under the terms of the GNU LGPL, version 2 or later.
 * See the COPYING.LIB file in the top-level directory.
 */

#include "qemu/osdep.h"
#include "xnu/boot/xnuboot.h"
#include "xnu/boot/args.h"

static void test_page_constants_are_64bit(void)
{
    g_assert_cmphex(ONE_KB, ==, 0x400ULL);
    g_assert_cmphex(ONE_MB, ==, 0x100000ULL);
    g_assert_cmphex(ONE_GB, ==, 0x40000000ULL);
    g_assert_cmphex(DARWIN_PAGE_SIZE, ==, 0x4000ULL);
    g_assert_cmphex(DARWIN_HUGE_PAGE_SIZE, ==, 0x2000000ULL);
    g_assert_cmphex(XNU_STRIP_VMA(0xfffffff0270a4f74ULL),
                    ==, 0x0000000270a4f74ULL & 0x7ffffffffULL);
    g_assert_cmphex(BIT_ULL(36) - 1, ==, 0xfffffffffULL);
    g_assert_cmphex(BIT_ULL(63), ==, 0x8000000000000000ULL);
}

static void test_round_next_page_preserves_upper_bits(void)
{
    /* Exact Phase 5F fault coordinates. */
    g_assert_cmphex(ROUND_NEXT_PAGE(0x100076a0000ULL),
                    ==, 0x100076a0000ULL);
    g_assert_cmphex(ROUND_NEXT_PAGE(0x10015ea0000ULL),
                    ==, 0x10015ea0000ULL);

    /* Rounding must carry upward without discarding bits 63:32. */
    g_assert_cmphex(ROUND_NEXT_PAGE(0x100076a0001ULL),
                    ==, 0x100076a4000ULL);
    g_assert_cmphex(ROUND_NEXT_PAGE(0x10000000000ULL),
                    ==, 0x10000000000ULL);
    g_assert_cmphex(ROUND_NEXT_PAGE(0x10000000001ULL),
                    ==, 0x10000004000ULL);

    /* Values just below and above 4 GiB must never truncate. */
    g_assert_cmphex(ROUND_NEXT_PAGE(0xffffffffULL), ==, 0x100000000ULL);
    g_assert_cmphex(ROUND_NEXT_PAGE(0x100000001ULL), ==, 0x100004000ULL);
}

static void test_boot_args_abi_layout(void)
{
    g_assert_cmpuint(sizeof(Boot_Video), ==, 48);
    g_assert_cmpuint(sizeof(boot_args), ==, 1152);
    g_assert_cmpuint(offsetof(boot_args, virtBase), ==, 8);
    g_assert_cmpuint(offsetof(boot_args, physBase), ==, 16);
    g_assert_cmpuint(offsetof(boot_args, memSize), ==, 24);
    g_assert_cmpuint(offsetof(boot_args, topOfKernelData), ==, 32);
    g_assert_cmpuint(offsetof(boot_args, Video), ==, 40);
    g_assert_cmpuint(offsetof(boot_args, deviceTreeP), ==, 96);
    g_assert_cmpuint(offsetof(boot_args, CommandLine), ==, 108);
    g_assert_cmpuint(offsetof(boot_args, bootFlags), ==, 1136);
    g_assert_cmpuint(offsetof(boot_args, memSizeActual), ==, 1144);
}

int main(int argc, char **argv)
{
    g_test_init(&argc, &argv, NULL);

    g_test_add_func("/xnu/llp64/page-constants", test_page_constants_are_64bit);
    g_test_add_func("/xnu/llp64/round-next-page", test_round_next_page_preserves_upper_bits);
    g_test_add_func("/xnu/llp64/boot-args-layout", test_boot_args_abi_layout);

    return g_test_run();
}


--- test-macho-fileset.c ---

/*
 * macho_find_fileset_entry LC_FILESET_ENTRY parsing tests.
 *
 * entry_id is an lc_str offset relative to the load command start, not
 * a fixed sizeof(fileset_entry_command) offset. Malformed entries must
 * fail closed (be skipped) rather than read out of bounds.
 *
 * This work is licensed under the terms of the GNU LGPL, version 2 or later.
 * See the COPYING.LIB file in the top-level directory.
 */

#include "qemu/osdep.h"
#include "xnu/mach-o/loader.h"
#include "xnu/macho.h"

/*
 * Layout of the synthetic load command buffer:
 *   [ fse_t header (32 bytes) ][ pad (8) ][ entry id string ]
 * entry_id.offset points past the padding so it differs from sizeof(fse_t).
 */
#define FSE_PAD 8

static fse_t *make_fileset_cmd(const char *entry_id, uint32_t extra_pad,
                               uint8_t **out_buf, size_t *out_len)
{
    size_t id_len = strlen(entry_id) + 1;
    uint32_t cmdsize = (uint32_t)(sizeof(fse_t) + extra_pad + id_len);
    uint8_t *buf = g_malloc0(cmdsize);
    fse_t *f = (fse_t *)buf;

    f->cmd = LC_FILESET_ENTRY;
    f->cmdsize = cmdsize;
    f->vmaddr = 0xfffffff027100000ULL;
    f->fileoff = 0x1000;
    f->entry_id.offset = (uint32_t)(sizeof(fse_t) + extra_pad);

    memcpy(buf + f->entry_id.offset, entry_id, id_len);

    *out_buf = buf;
    *out_len = cmdsize;
    return f;
}

static void test_entry_id_offset_not_sizeof(void)
{
    uint8_t *cmd; size_t cmd_len;
    make_fileset_cmd("com.apple.security.AppleImage4", FSE_PAD, &cmd, &cmd_len);

    fse_t *f = (fse_t *)cmd;
    g_assert_cmpuint(f->entry_id.offset, !=, sizeof(fse_t));

    const char *id = macho_fse_entry_id(f);
    g_assert_nonnull(id);
    g_assert_cmpstr(id, ==, "com.apple.security.AppleImage4");

    g_free(cmd);
}

static void test_zero_pad_still_matches(void)
{
    uint8_t *cmd; size_t cmd_len;
    make_fileset_cmd("kext", 0, &cmd, &cmd_len);

    g_assert_cmpuint(((fse_t *)cmd)->entry_id.offset, ==, sizeof(fse_t));
    g_assert_nonnull(macho_fse_entry_id((fse_t *)cmd));

    g_free(cmd);
}

static void test_offset_out_of_cmdsize_fails_closed(void)
{
    uint8_t *cmd; size_t cmd_len;
    fse_t *f = make_fileset_cmd("kext", 0, &cmd, &cmd_len);

    /* Offset at or beyond cmdsize must never be dereferenced. */
    f->entry_id.offset = f->cmdsize;
    g_assert_null(macho_fse_entry_id(f));

    f->entry_id.offset = f->cmdsize + 0x1000;
    g_assert_null(macho_fse_entry_id(f));

    g_free(cmd);
}

static void test_unterminated_string_fails_closed(void)
{
    uint8_t *cmd; size_t cmd_len;
    fse_t *f = make_fileset_cmd("kext", 0, &cmd, &cmd_len);

    /* Remove the NUL so no terminator exists inside cmdsize. */
    cmd[cmd_len - 1] = 'x';
    g_assert_null(macho_fse_entry_id((fse_t *)cmd));

    g_free(cmd);
}

int main(int argc, char **argv)
{
    g_test_init(&argc, &argv, NULL);

    g_test_add_func("/macho/fileset/offset-not-sizeof", test_entry_id_offset_not_sizeof);
    g_test_add_func("/macho/fileset/zero-pad", test_zero_pad_still_matches);
    g_test_add_func("/macho/fileset/offset-oob-fail-closed", test_offset_out_of_cmdsize_fails_closed);
    g_test_add_func("/macho/fileset/unterminated-fail-closed", test_unterminated_string_fails_closed);

    return g_test_run();
}

