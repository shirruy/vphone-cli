/*
 * XNU boot LLP64 ABI regression tests.
 *
 * Windows x64 is LLP64: unsigned long is 32 bits wide.  The XNU boot
 * headers must never derive address masks or page constants from
 * host-width BIT() definitions, otherwise every guest physical
 * address at or above 4 GiB is truncated to its low 32 bits.  The
 * Phase 5F SPTM Data Abort was caused by exactly this defect in
 * ROUND_NEXT_PAGE via ONE_KB/ONE_MB/ONE_GB.
 *
 * This work is licensed under the terms of the GNU LGPL, version 2 or later.
 * See the COPYING.LIB file in the top-level directory.
 */

#include "qemu/osdep.h"
#include "xnu/boot/xnuboot.h"
#include "xnu/boot/args.h"

static void test_page_constants_are_64bit(void)
{
    g_assert_cmphex(ONE_KB, ==, 0x400ULL);
    g_assert_cmphex(ONE_MB, ==, 0x100000ULL);
    g_assert_cmphex(ONE_GB, ==, 0x40000000ULL);
    g_assert_cmphex(DARWIN_PAGE_SIZE, ==, 0x4000ULL);
    g_assert_cmphex(DARWIN_HUGE_PAGE_SIZE, ==, 0x2000000ULL);
    g_assert_cmphex(XNU_STRIP_VMA(0xfffffff0270a4f74ULL),
                    ==, 0x0000000270a4f74ULL & 0x7ffffffffULL);
    g_assert_cmphex(BIT_ULL(36) - 1, ==, 0xfffffffffULL);
    g_assert_cmphex(BIT_ULL(63), ==, 0x8000000000000000ULL);
}

static void test_round_next_page_preserves_upper_bits(void)
{
    /* Exact Phase 5F fault coordinates. */
    g_assert_cmphex(ROUND_NEXT_PAGE(0x100076a0000ULL),
                    ==, 0x100076a0000ULL);
    g_assert_cmphex(ROUND_NEXT_PAGE(0x10015ea0000ULL),
                    ==, 0x10015ea0000ULL);

    /* Rounding must carry upward without discarding bits 63:32. */
    g_assert_cmphex(ROUND_NEXT_PAGE(0x100076a0001ULL),
                    ==, 0x100076a4000ULL);
    g_assert_cmphex(ROUND_NEXT_PAGE(0x10000000000ULL),
                    ==, 0x10000000000ULL);
    g_assert_cmphex(ROUND_NEXT_PAGE(0x10000000001ULL),
                    ==, 0x10000004000ULL);

    /* Values just below and above 4 GiB must never truncate. */
    g_assert_cmphex(ROUND_NEXT_PAGE(0xffffffffULL), ==, 0x100000000ULL);
    g_assert_cmphex(ROUND_NEXT_PAGE(0x100000001ULL), ==, 0x100004000ULL);
}

static void test_boot_args_abi_layout(void)
{
    g_assert_cmpuint(sizeof(Boot_Video), ==, 48);
    g_assert_cmpuint(sizeof(boot_args), ==, 1152);
    g_assert_cmpuint(offsetof(boot_args, virtBase), ==, 8);
    g_assert_cmpuint(offsetof(boot_args, physBase), ==, 16);
    g_assert_cmpuint(offsetof(boot_args, memSize), ==, 24);
    g_assert_cmpuint(offsetof(boot_args, topOfKernelData), ==, 32);
    g_assert_cmpuint(offsetof(boot_args, Video), ==, 40);
    g_assert_cmpuint(offsetof(boot_args, deviceTreeP), ==, 96);
    g_assert_cmpuint(offsetof(boot_args, CommandLine), ==, 108);
    g_assert_cmpuint(offsetof(boot_args, bootFlags), ==, 1136);
    g_assert_cmpuint(offsetof(boot_args, memSizeActual), ==, 1144);
}

int main(int argc, char **argv)
{
    g_test_init(&argc, &argv, NULL);

    g_test_add_func("/xnu/llp64/page-constants", test_page_constants_are_64bit);
    g_test_add_func("/xnu/llp64/round-next-page", test_round_next_page_preserves_upper_bits);
    g_test_add_func("/xnu/llp64/boot-args-layout", test_boot_args_abi_layout);

    return g_test_run();
}

